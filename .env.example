# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ostrev.com

# Stripe. Without STRIPE_SECRET_KEY the checkout runs in demo mode (no money moves).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where newsletter / drop-notify / contact submissions are forwarded (JSON POST).
# Point these at Klaviyo, Mailchimp, Zapier, Make, your own API, etc.
NEWSLETTER_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
